{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": [
    "jdk{{ java_version }}@latest",
    "maven@latest",
    "detect-secrets@latest",
    "trivy@latest",
    "git@latest",
    "gh@latest"
  ],
  "shell": {
    "scripts": {
      "dev":          "mvn -B spring-boot:run",
{%- if needs_database %}
      "db-up":        "docker run --rm --name {{ project_name }}-db -p 5432:5432 -e POSTGRES_USER=app -e POSTGRES_PASSWORD=dev -e POSTGRES_DB={{ project_name | replace('-', '_') }} postgres:17",
{%- endif %}
      "test":         "mvn -B verify",
      "test-fast":    "mvn -B test",
      "spec-check":   "bash scripts/spec-check.sh",
      "lint":         "mvn -B spotless:check checkstyle:check",
      "lint-fix":     "mvn -B spotless:apply",
      "typecheck":    "mvn -B -DskipTests compile test-compile",
      "quality":      "devbox run lint && devbox run typecheck",
      "audit":        "if [ -n \"$NVD_API_KEY\" ]; then mvn -B org.owasp:dependency-check-maven:check -DfailBuildOnCVSS=7 -DnvdApiKey=$NVD_API_KEY; else echo 'NVD_API_KEY not set: auditing dependencies with trivy instead of OWASP Dependency-Check'; mvn -B -q dependency:resolve && trivy fs --offline-scan --scanners vuln --severity HIGH,CRITICAL --exit-code 1 --skip-dirs target --skip-dirs .devbox .; fi",
      "secrets-scan": "git ls-files -z | xargs -0 detect-secrets-hook --baseline .secrets.baseline.json",
      "security":     "devbox run audit && devbox run secrets-scan",
      "ci":           "devbox run quality && devbox run test && devbox run security",
      "image-build":  "docker build -t {{ project_name }}:scan .",
      "image-scan":   "trivy image --severity CRITICAL,HIGH --format table {{ project_name }}:scan"
    }
  }
}
