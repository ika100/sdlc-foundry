spring:
  application:
    name: {{ project_name }}
{%- if needs_database %}
  # Connection settings come from the platform's postgres addon (PGHOST, PGPORT, PGDATABASE, PGUSER, PGPASSWORD);
  # the defaults match `devbox run db-up` for local development.
  datasource:
    url: jdbc:postgresql://${PGHOST:localhost}:${PGPORT:5432}/${PGDATABASE:{{ project_name | replace('-', '_') }}}
    username: ${PGUSER:app}
    password: ${PGPASSWORD:dev}
    hikari:
      initialization-fail-timeout: 60000   # wait up to 60 s for the database at startup instead of crash-looping while it initialises
  jpa:
    open-in-view: false
    hibernate:
      ddl-auto: validate           # the schema belongs to Flyway (src/main/resources/db/migration)
  flyway:
    enabled: true
{%- endif %}

server:
  port: ${PORT:{{ port }}}
  shutdown: graceful

management:
  endpoint:
    health:
      probes:
        enabled: true            # /actuator/health/liveness and /actuator/health/readiness
{%- if needs_database %}
      group:
        readiness:
          include: readinessState,db   # not ready while the database is unreachable
{%- endif %}
  endpoints:
    web:
      exposure:
        include: health,info{% if needs_observability %},prometheus{% endif %}
{%- if needs_observability %}
  metrics:
    tags:
      service: {{ project_name }}
{%- endif %}

logging:
{%- if needs_observability %}
  structured:
    format:
      console: logstash          # JSON lines; the OTel Java agent's MDC keys trace_id and span_id become top-level fields
{%- endif %}
  level:
    root: ${LOG_LEVEL:INFO}
