# cluster.yaml: the only file of this repo you edit by hand. `devbox run render` writes everything under cluster/ from it.
# Keys not listed here are rejected by the render.

# The cluster's name: a lowercase DNS label of at most 40 characters (required).
cluster: {{ project_name }}

# Who owns the cluster: a team or person (required, non-empty).
owner: {{ owner }}

# The Kubernetes API server Argo CD deploys to (an http(s) URL). The default is the cluster Argo CD runs in.
server: https://kubernetes.default.svc

# The GitHub owner Argo CD reads this repo and every registered system repo from. It must be the owner of this repo.
org: {{ github_org }}

# Cluster-level operators to install, in this order. The allowed names are the operators of the platform's versions table
# (cloudnative-pg, external-secrets, kyverno, seaweedfs). `devbox run check` tells you which ones the registered systems need.
operators: []

# Optional, only with external-secrets in operators: the ClusterSecretStore systems read their secrets from.
#   secretStore:
#     name: platform-secrets          # default platform-secrets
#     provider: {vault: {...}}        # one External Secrets provider block; default: the Kubernetes provider over the secrets-store namespace

# The systems that run on this cluster: name -> {repo: <owner>/<name>} (the system's gitops repo, owned by `org`).
# Do not edit by hand: use /cluster:add and /cluster:remove.
systems: {}
