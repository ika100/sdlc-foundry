# Per-application settings for the {{ app_name }} product (read by scripts/render.py).
#
# gateway: the Gateway API gateway that exposed services attach to. `devbox run cluster-up` installs Traefik's gateway
#          (traefik-gateway in kube-system). Real clusters: point this at your gateway.
# hosts:   hostname template per environment for services with `expose:`. No entry = not exposed in that environment.
#          Placeholders: {service} (expose.host or the service name), {app}, {env}.
#          *.localhost resolves to 127.0.0.1 in browsers and curl without any DNS or /etc/hosts setup.
# urls:    optional (spec 091): the URL `cplat smoke` and `cplat ship deploy` use to reach a service per environment, when it is not
#          the one derived from `hosts` (for example a local cluster on another port). {host} is the host `hosts` gives the service;
#          {service}, {app} and {env} work too. `render.py` ignores this key. No entry = https://<host>, or http://<host>:8088 for
#          *.localhost (set LOCAL_HTTP_PORT if `cluster-up` printed another port).
# urls:
#   dev: "http://{host}:8088"
# secretStore: the (Cluster)SecretStore that `remote` secrets in services.yaml are read from (External Secrets Operator, ADR-018).
#          `cluster-up` creates `platform-secrets` (reads Secrets from the secrets-store namespace). Real clusters: point this
#          at your Vault / AWS / GCP store. `generate` secrets need no store: ESO generates random values in the cluster.
secretStore:
  name: platform-secrets
  kind: ClusterSecretStore
# policies: Kyverno guard rails per environment (ADR-022): non-root numeric user, read-only filesystem, no privilege escalation,
#          dropped capabilities, no privileged/host access, resource requests + memory limit, part-of label, allowed image
#          registries (taken from your services' images; add more under `registries`), and no `:latest` outside dev.
#          Opt in by uncommenting; needs Kyverno in the cluster (`cluster-up` installs it locally). Mode per environment:
#          Audit (report only), Enforce (deny) or Off; defaults Audit in dev/staging, Enforce in prod.
#          `devbox run validate` also checks the rendered manifests offline, so a violating change fails its pull request.
# policies:
#   mode: {dev: Audit, staging: Audit, prod: Enforce}
#   registries: []
# addons:  backing services, one per application and environment (ADR-020). Declare with `/gitops:addon add postgres`, then
#          list it under `uses:` of the services that need it: they get DATABASE_URL and PG* from the operator's Secret.
#          Values may be per environment: {dev: 1, prod: 3}. Needs the CloudNativePG operator (`cluster-up` installs it locally).
#          observability = an OpenTelemetry collector per environment (ADR-021): every service gets OTEL_* variables, the
#          collector receives OTLP and scrapes each service's Prometheus `metrics:` path. Optional backends: `ui: lgtm` (local
#          Grafana/Tempo/Loki/Prometheus dev stack that `cluster-up` installs, http://grafana.localhost:8088 (or the port cluster-up prints)) or
#          `exportTo: https://your-otlp-http-endpoint` (+ `headersSecret: <Secret with key AUTHORIZATION>`).
# addons:
#   postgres: {version: 17, instances: {dev: 1, prod: 3}, storage: {dev: 1Gi, prod: 20Gi}}
#   observability: {ui: lgtm}
# Alert issues (spec 092): every 15 minutes `alerts.yml` turns firing alerts into issues in the service's `repo` (or this repo).
#          Built in: ServiceDown, a service with no up series for 5 minutes. Add your own PromQL rules; `alerts: false` switches the poll off.
#          queryURL / alertmanagerURL / querySecret (Secret key AUTHORIZATION, `name` or `namespace/name`) point at a Prometheus or
#          Alertmanager other than the local lgtm stack. Rules on OTLP-pushed metrics need the environment from `target_info`.
# addons:
#   observability:
#     ui: lgtm
#     alerts: true
#     rules:
#       - name: HighErrorRate
#         query: 'sum by (job, instance) (rate(http_server_requests_seconds_count{status=~"5.."}[5m])) > 1'
#         severity: warning        # critical | warning | info
#         summary: More than one 5xx per second
#     queryURL: https://prom.example.com/api/prom
#     querySecret: obs-query
#     alertmanagerURL: https://am.example.com
# promotion: (spec 093) `staging: auto` = a green dev smoke in `cplat ship` promotes staging through the self-merging
#          `pin-staging.yml` PR; `staging: manual` = only `/gitops:promote`; unset = manual. A service entry in services.yaml
#          may override it. Prod is always manual (`/gitops:promote <svc> staging prod`); `promotion.prod` is rejected unless `manual`.
promotion:
  staging: auto
gateway:
  name: traefik-gateway
  namespace: kube-system
hosts:
  dev: "{service}.{app}-dev.localhost"
  # staging: "{service}.staging.example.com"
  # prod: "{service}.example.com"
