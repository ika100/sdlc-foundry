using System.Diagnostics;
using System.Text.Encodings.Web;
using System.Text.Json;
using Microsoft.Extensions.Logging.Abstractions;
using Microsoft.Extensions.Logging.Console;

namespace {{ namespace }};

/// <summary>
/// One JSON object per line on stdout: <c>time</c>, <c>level</c>, <c>msg</c>, <c>logger</c> and the fields of the message
/// template. Inside an active span (Activity) the line also carries its <c>trace_id</c> and <c>span_id</c>, so logs and
/// traces join.
/// </summary>
public sealed class JsonLineFormatter() : ConsoleFormatter(FormatterName)
{
    /// <summary>The formatter's name in the console logger options.</summary>
    public const string FormatterName = "json-line";

    /// <inheritdoc />
    public override void Write<TState>(in LogEntry<TState> logEntry, IExternalScopeProvider? scopeProvider, TextWriter textWriter)
    {
        var message = logEntry.Formatter(logEntry.State, logEntry.Exception);
        if (message is null && logEntry.Exception is null)
        {
            return;
        }

        textWriter.WriteLine(Format(logEntry.LogLevel, logEntry.Category, message, logEntry.State, logEntry.Exception, Activity.Current));
    }

    // Log lines are not HTML: `+`, `<` and quotes stay readable instead of \u002B escapes.
    private static readonly JsonWriterOptions WriterOptions = new() { Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping };

    /// <summary>The JSON line of one entry (separate from <see cref="Write{TState}"/> so that tests can call it).</summary>
    public static string Format(LogLevel level, string category, string? message, object? state, Exception? exception, Activity? activity)
    {
        using var buffer = new MemoryStream();
        using (var json = new Utf8JsonWriter(buffer, WriterOptions))
        {
            json.WriteStartObject();
            json.WriteString("time", DateTime.UtcNow.ToString("yyyy-MM-dd'T'HH:mm:ss.fff'Z'", System.Globalization.CultureInfo.InvariantCulture));
            json.WriteString("level", LevelName(level));
            json.WriteString("msg", message ?? string.Empty);
            json.WriteString("logger", category);
            if (activity is not null && activity.TraceId != default)
            {
                json.WriteString("trace_id", activity.TraceId.ToHexString());
                json.WriteString("span_id", activity.SpanId.ToHexString());
            }

            if (state is IReadOnlyList<KeyValuePair<string, object?>> fields)
            {
                foreach (var (key, value) in fields)
                {
                    if (key == "{OriginalFormat}" || key is "time" or "level" or "msg" or "logger" or "trace_id" or "span_id")
                    {
                        continue;
                    }

                    json.WritePropertyName(key);
                    JsonSerializer.Serialize(json, value?.ToString());
                }
            }

            if (exception is not null)
            {
                json.WriteString("error", exception.ToString());
            }

            json.WriteEndObject();
        }

        return System.Text.Encoding.UTF8.GetString(buffer.ToArray());
    }

    private static string LevelName(LogLevel level) => level switch
    {
        LogLevel.Trace => "trace",
        LogLevel.Debug => "debug",
        LogLevel.Information => "info",
        LogLevel.Warning => "warn",
        LogLevel.Error => "error",
        LogLevel.Critical => "fatal",
        _ => "info",
    };
}
