{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": [
    "dotnet-sdk_{{ dotnet_major }}@{{ dotnet_sdk_version }}",
    "detect-secrets@1.5.0",
    "trivy@0.74.0",
    "git@latest",
    "gh@latest"
  ],
  "env": {
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOGO": "1",
    "DOTNET_CLI_UI_LANGUAGE": "en"
  },
  "shell": {
    "scripts": {
      "install":      "{% if needs_database %}dotnet tool restore && {% endif %}dotnet restore --locked-mode",
      "dev":          "dotnet watch --project src/{{ namespace }} run",
      "build":        "dotnet build --no-restore -c Release",
      "start":        "dotnet run --project src/{{ namespace }} -c Release",
      "test":         "SMOKE_BASE_URL= bash scripts/gate.sh tests test dotnet -- dotnet test -p:CollectCoverage=true -p:Threshold=80 -p:ThresholdType=line -p:CoverletOutputFormat=cobertura -p:CoverletOutput=../../coverage/ \"$@\"",
      "test-fast":    "SMOKE_BASE_URL= bash scripts/gate.sh tests test-fast dotnet -- dotnet test \"$@\"",
      "smoke":        "bash scripts/smoke.sh",
      "spec-check":   "bash scripts/spec-check.sh",
      "lint":         "dotnet format --verify-no-changes --severity warn",
      "lint-fix":     "dotnet format --severity warn",
      "typecheck":    "dotnet build --no-incremental -c Release",
      "quality":      "devbox run lint && devbox run typecheck",
{%- if needs_database %}
      "db-up":        "docker run --rm --name {{ project_name }}-db -p 5432:5432 -e POSTGRES_USER=app -e POSTGRES_HOST_AUTH_METHOD=trust -e POSTGRES_DB={{ project_name | replace('-', '_') }} postgres:17",
      "migrate-new":  "dotnet ef migrations add \"$@\" --project src/{{ namespace }} --output-dir Data/Migrations",
{%- endif %}
      "audit":        "bash scripts/deps.sh audit",
      "secrets-scan": "bash scripts/gate.sh files secrets-scan ':!**/packages.lock.json' && git ls-files -z ':!**/packages.lock.json' | xargs -0 detect-secrets-hook --baseline .secrets.baseline.json --exclude-files copier-answers --disable-filter detect_secrets.filters.gibberish.should_exclude_secret",
      "secrets-baseline": "grep -qs is_line_allowlisted .secrets.baseline.json || detect-secrets scan --exclude-files 'packages\\.lock\\.json$' --disable-filter detect_secrets.filters.gibberish.should_exclude_secret > .secrets.baseline.json; detect-secrets scan --baseline .secrets.baseline.json --exclude-files 'packages\\.lock\\.json$' --disable-filter detect_secrets.filters.gibberish.should_exclude_secret",
      "security":     "devbox run audit && devbox run secrets-scan",
      "deps-findings": "bash scripts/deps.sh findings \"$@\"",
      "deps-bump":    "bash scripts/deps.sh bump \"$@\"",
      "ci":           "devbox run install && devbox run quality && devbox run test && devbox run security && if grep -qs '\"ci-extra\"[[:space:]]*:' devbox.json; then devbox run ci-extra; fi",
      "image-build":  "docker build -t {{ project_name }}:scan .",
      "image-scan":   "trivy image --severity CRITICAL,HIGH --format table {{ project_name }}:scan"
    }
  }
}
