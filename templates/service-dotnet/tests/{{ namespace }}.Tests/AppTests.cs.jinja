using System.Net;
using System.Net.Http.Json;
using Microsoft.Extensions.Diagnostics.HealthChecks;

namespace {{ namespace }}.Tests;

public sealed class AppTests
{
    private sealed record Status(string status);

    [Fact]
    public async Task Health_answers_ok()
    {
        await using var app = TestApp.Create();
        var response = await app.CreateClient().GetAsync(new Uri("/health", UriKind.Relative), TestContext.Current.CancellationToken);

        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
        Assert.Equal("ok", (await response.Content.ReadFromJsonAsync<Status>(TestContext.Current.CancellationToken))!.status);
    }

    [Fact]
    public async Task Ready_answers_ready_while_every_dependency_answers()
    {
        await using var app = TestApp.Create();
        var response = await app.CreateClient().GetAsync(new Uri("/ready", UriKind.Relative), TestContext.Current.CancellationToken);

        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
        Assert.Equal("ready", (await response.Content.ReadFromJsonAsync<Status>(TestContext.Current.CancellationToken))!.status);
    }

    [Fact]
    public async Task Ready_answers_503_while_a_dependency_does_not()
    {
        await using var app = TestApp.Create(services => services.AddHealthChecks()
            .AddCheck("down", () => HealthCheckResult.Unhealthy(), [ServiceApp.ReadyTag]));
        var response = await app.CreateClient().GetAsync(new Uri("/ready", UriKind.Relative), TestContext.Current.CancellationToken);

        Assert.Equal(HttpStatusCode.ServiceUnavailable, response.StatusCode);
        Assert.Equal("unavailable", (await response.Content.ReadFromJsonAsync<Status>(TestContext.Current.CancellationToken))!.status);
    }

    [Fact]
    public async Task Liveness_ignores_the_readiness_checks()
    {
        await using var app = TestApp.Create(services => services.AddHealthChecks()
            .AddCheck("down", () => HealthCheckResult.Unhealthy(), [ServiceApp.ReadyTag]));
        var response = await app.CreateClient().GetAsync(new Uri("/health", UriKind.Relative), TestContext.Current.CancellationToken);

        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
    }
}
