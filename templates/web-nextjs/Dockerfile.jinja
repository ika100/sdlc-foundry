# syntax=docker/dockerfile:1.7

FROM node:{{ node_major }}-slim AS deps
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml* ./
RUN pnpm install --frozen-lockfile


FROM node:{{ node_major }}-slim AS builder
WORKDIR /app
RUN corepack enable
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm build


FROM node:{{ node_major }}-slim AS runtime
# Links the GHCR package to this repository, so CI's GITHUB_TOKEN can push to it (no manual "Manage Actions access" step).
LABEL org.opencontainers.image.source="https://github.com/{{ github_org }}/{{ project_name }}" \
      org.opencontainers.image.description="{{ description | replace('"', '') | replace('\\', '') }}"
WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT={{ port }} \
    HOSTNAME=0.0.0.0

# Standalone output: server.js + the minimal node_modules it needs.
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static
COPY --from=builder --chown=node:node /app/public ./public

# Numeric UID: Kubernetes cannot verify runAsNonRoot for a named user (1000 = the image's "node" user).
USER 1000:1000

EXPOSE {{ port }}

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD node -e "fetch('http://localhost:{{ port }}/api/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["node", "server.js"]
