{
  "name": "@{{ github_org | lower }}/{{ project_name }}",
  "version": "0.0.0-dev.0",
  "description": "{{ description | replace('"', '') | replace('\\', '') }}",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">={{ node_major }}"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/{{ github_org }}/{{ project_name }}.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:fast": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^{{ node_major }}",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.0.5"
  }
}
