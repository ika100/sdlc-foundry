import { describe, expect, it } from "vitest";

import { loadConfig, logLevel } from "../src/config.js";

describe("config", () => {
  it("defaults without environment", () => {
    expect(loadConfig({})).toEqual({ port: {{ port }}, logLevel: "info", serviceName: "{{ project_name }}" });
  });

  it("reads PORT, LOG_LEVEL and OTEL_SERVICE_NAME", () => {
    expect(loadConfig({ PORT: "9000", LOG_LEVEL: "DEBUG", OTEL_SERVICE_NAME: "x" })).toEqual({
      port: 9000,
      logLevel: "debug",
      serviceName: "x",
    });
  });

  it("falls back on an invalid port and an unknown level", () => {
    expect(loadConfig({ PORT: "abc" }).port).toBe({{ port }});
    expect(logLevel("verbose")).toBe("info");
  });
});
