{
  "name": "{{ project_name }}",
  "version": "0.1.0",
  "private": true,
  "description": "{{ description | replace('"', '') | replace('\\', '') }}",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">={{ node_major }}"
  },
  "scripts": {
    "dev": "tsx watch{% if needs_observability %} --import ./src/telemetry.ts{% endif %} src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node{% if needs_observability %} --import ./dist/telemetry.js{% endif %} dist/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:fast": "vitest run"{% if needs_database %},
    "migrate:new": "drizzle-kit generate"{% endif %}
  },
  "dependencies": {
    "fastify": "^5.12.8",
    "pino": "^10.4.0"{% if needs_observability %},
    "@fastify/otel": "^1.0.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.301.2",
    "@opentelemetry/instrumentation-http": "^0.301.2",
    "@opentelemetry/sdk-node": "^0.301.2",
    "prom-client": "^15.1.3"{% endif %}{% if needs_database %},
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"{% if needs_observability %},
    "@opentelemetry/instrumentation-pg": "^0.78.0"{% endif %}{% endif %}
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^{{ node_major }}",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"{% if needs_database %},
    "@testcontainers/postgresql": "^12.2.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"{% endif %}
  }
}
