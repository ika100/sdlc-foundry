{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": [
    "go@{{ go_version }}",
    "golangci-lint@latest",
    "gotools@latest",
    "govulncheck@latest",
    "detect-secrets@1.5.0",
    "trivy@0.74.0",
    "git@latest",
    "gh@latest"
  ],
  "shell": {
    "scripts": {
      "dev":          "go run ./cmd/{{ project_name }}",
      "test":         "go test -race -cover ./...",
      "test-fast":    "go test ./...",
      "spec-check":   "bash scripts/spec-check.sh",
      "lint":         "golangci-lint run",
      "lint-fix":     "gofmt -w . && goimports -w . && golangci-lint run --fix",
      "typecheck":    "go build ./...",
      "quality":      "devbox run lint && devbox run typecheck",
      "audit":        "govulncheck ./...",
      "secrets-scan": "git ls-files -z ':!go.sum' | xargs -0 detect-secrets-hook --baseline .secrets.baseline.json --disable-filter detect_secrets.filters.gibberish.should_exclude_secret",
      "secrets-baseline": "grep -qs is_line_allowlisted .secrets.baseline.json || detect-secrets scan --exclude-files 'go\\.sum$' --disable-filter detect_secrets.filters.gibberish.should_exclude_secret > .secrets.baseline.json; detect-secrets scan --baseline .secrets.baseline.json --exclude-files 'go\\.sum$' --disable-filter detect_secrets.filters.gibberish.should_exclude_secret",
      "security":     "devbox run audit && devbox run secrets-scan",
      "ci":           "devbox run quality && devbox run test && devbox run security",
      "image-build":  "docker build --build-arg VERSION=scan -t {{ project_name }}:scan .",
      "image-scan":   "trivy image --severity CRITICAL,HIGH --format table {{ project_name }}:scan"
    }
  }
}
