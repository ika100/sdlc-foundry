{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "worktree": {"baseRef": "head"},
  "extraKnownMarketplaces": {
    "sdlc-foundry": {
      "source": {
        "source": "github",
        "repo": "ika100/sdlc-foundry",
        "ref": "{{ platform_marketplace_ref }}"
      }
    }
  },
  "enabledPlugins": {
    "svc-go@sdlc-foundry": true,
    "svc@sdlc-foundry": true,
    "shared@sdlc-foundry": true
  },
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(cplat *)",
      "Bash(git commit *)",
      "Bash(git pull --ff-only)",
      "Bash(git pull --ff-only *)",
      "Bash(git pull -q --ff-only)",
      "Bash(git pull -q --ff-only *)",
      "Bash(git branch -D worktree-agent-*)",
      "Bash(git branch -D -q worktree-agent-*)",
      "Bash(gh pr create *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr comment *)",
      "Bash(gh run rerun *)",
      "Bash(gh run cancel *)",
      "Bash(gh run watch *)",
      "Bash(gh workflow run *)",
      "Bash(gh issue comment *)",
      "Bash(gh api repos/*/actions/jobs/*/logs*)",
      "Bash(gh api repos/*/commits/*/check-runs*)",
      "Bash(docker build *)",
      "Bash(docker run --rm *)",
      "Bash(docker image inspect *)",
      "Bash(docker rmi *)",
      "Bash(docker rm *)",

      "Bash(devbox run *)",
      "Bash(devbox install)",
      "Bash(devbox shell)",
      "Bash(devbox info *)",
      "Bash(devbox version)",
      "Bash(devbox list)",

      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git log)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch --list *)",
      "Bash(git branch -d *)",
      "Bash(git rev-parse *)",
      "Bash(git symbolic-ref *)",
      "Bash(git describe *)",
      "Bash(git ls-files *)",
      "Bash(git config --get *)",
      "Bash(git config --get-all *)",
      "Bash(git remote -v)",
      "Bash(git remote show *)",
      "Bash(git worktree list *)",
      "Bash(git worktree list)",
      "Bash(git blame *)",
      "Bash(git for-each-ref *)",

      "Bash(git add *)",
      "Read(~/.claude/plugins/**)",
      "Bash(git merge --no-ff *)",
      "Bash(git merge --no-ff --no-edit *)",
      "Bash(git merge --abort)",
      "Bash(git worktree add *)",
      "Bash(git worktree remove *)",
      "Bash(git worktree prune *)",
      "Bash(git worktree prune)",
      "Bash(git checkout -b *)",
      "Bash(git stash)",
      "Bash(git stash push *)",
      "Bash(git stash pop)",
      "Bash(git stash apply *)",
      "Bash(git stash list)",
      "Bash(git stash list *)",
      "Bash(git tag)",
      "Bash(git tag -l *)",
      "Bash(git tag -a *)",
      "Bash(git tag --list *)",
      "Bash(git tag -d *)",

      "Bash(git fetch *)",
      "Bash(git fetch)",

      "Bash(git push -u origin feature/*)",
      "Bash(git push -u origin fix/*)",
      "Bash(git push -u origin chore/*)",
      "Bash(git push -u origin docs/*)",
      "Bash(git push -u origin refactor/*)",
      "Bash(git push -u origin perf/*)",
      "Bash(git push -u origin test/*)",
      "Bash(git push -u origin release/*)",
      "Bash(git push origin v*)",

      "Bash(git merge --ff-only *)",

      "Bash(git checkout main)",
      "Bash(git checkout feature/*)",
      "Bash(git checkout fix/*)",
      "Bash(git checkout chore/*)",
      "Bash(git checkout docs/*)",
      "Bash(git checkout refactor/*)",
      "Bash(git checkout perf/*)",
      "Bash(git checkout test/*)",
      "Bash(git checkout release/*)",
      "Bash(git switch *)",

      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr status *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh pr merge --merge release/*)",

      "Bash(kubectl rollout status *)",

      "Bash(ls)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(echo *)",
      "Bash(env)",
      "Bash(date)",
      "Bash(date *)",
      "Bash(tree *)",
      "Bash(tree)",
      "Bash(file *)",

      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(jq *)",
      "Bash(yq *)",

      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(diff *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(awk *)",
      "Bash(sed -n *)",

      "Bash(kubectl get *)",
      "Bash(kubectl describe *)",
      "Bash(kubectl logs *)",
      "Bash(kubectl explain *)",
      "Bash(kubectl version)",
      "Bash(kubectl version *)",
      "Bash(kubectl config current-context)",
      "Bash(kubectl config get-contexts)",
      "Bash(kubectl config view)",
      "Bash(kubectl apply --dry-run=* *)",
      "Bash(kubectl diff *)"

    ],
    "ask": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main)",
      "Bash(git pull *)",
      "Bash(git pull)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(git branch -D *)",
      "Bash(git checkout --)",
      "Bash(git checkout -- *)",
      "Bash(git commit --amend *)",
      "Bash(kubectl delete *)",
      "Bash(kubectl rollout restart *)",
      "Bash(kubectl rollout undo *)",
      "Bash(gh pr merge --squash *)",
      "Bash(gh pr merge --rebase *)",
      "Bash(gh release *)",
      "Bash(gh issue close *)",
      "Bash(docker push *)"
    ]
  }
}
