{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "worktree": {"baseRef": "head"},
  "extraKnownMarketplaces": {
    "sdlc-foundry": {
      "source": {
        "source": "github",
        "repo": "ika100/sdlc-foundry",
        "ref": "{{ platform_marketplace_ref }}"
      }
    }
  },
  "enabledPlugins": {
    "svc@sdlc-foundry": true,
    "shared@sdlc-foundry": true
  },
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(cplat *)",
      "Bash(git commit -s -m *)",
      "Bash(git commit -q -s -m *)",
      "Bash(git commit -s -q -m *)",
      "Bash(git pull --ff-only)",
      "Bash(git pull --ff-only *)",
      "Bash(git pull -q --ff-only)",
      "Bash(git pull -q --ff-only *)",
      "Bash(git branch -D worktree-agent-*)",
      "Bash(git branch -D -q worktree-agent-*)",
      "Bash(gh pr create *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr comment *)",
      "Bash(gh run rerun *)",
      "Bash(gh run cancel *)",
      "Bash(gh run watch *)",
      "Bash(gh workflow run *)",
      "Bash(gh issue comment *)",
      "Bash(gh api repos/*/actions/jobs/*/logs*)",
      "Bash(gh api repos/*/commits/*/check-runs*)",
      "Bash(docker build *)",
      "Bash(docker run --rm *)",
      "Bash(docker image inspect *)",
      "Bash(docker rmi *)",
      "Bash(docker rm *)",

      "Bash(devbox run *)",
      "Bash(devbox install)",
      "Bash(devbox shell)",
      "Bash(devbox info *)",
      "Bash(devbox version)",
      "Bash(devbox list)",

      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git log)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch --list *)",
      "Bash(git branch -d *)",
      "Bash(git rev-parse *)",
      "Bash(git symbolic-ref *)",
      "Bash(git describe *)",
      "Bash(git ls-files *)",
      "Bash(git remote -v)",
      "Bash(git worktree list *)",
      "Bash(git worktree list)",

      "Bash(git add *)",
      "Bash(git commit -m *)",
      "Bash(git commit --message *)",
      "Bash(git merge --no-ff *)",
      "Bash(git merge --no-ff --no-edit *)",
      "Bash(git merge --abort)",
      "Bash(git worktree add *)",
      "Bash(git worktree remove *)",
      "Bash(git checkout -b *)",
      "Bash(git tag -a *)",
      "Bash(git fetch *)",
      "Bash(git fetch)",

      "Bash(git push -u origin feature/*)",
      "Bash(git push -u origin fix/*)",
      "Bash(git push -u origin chore/*)",
      "Bash(git push -u origin docs/*)",
      "Bash(git push -u origin refactor/*)",
      "Bash(git push -u origin perf/*)",
      "Bash(git push -u origin test/*)",
      "Bash(git push -u origin release/*)",
      "Bash(git push origin v*)",

      "Bash(git checkout main)",
      "Bash(git checkout feature/*)",
      "Bash(git switch *)",

      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr merge --merge release/*)",

      "Bash(ls)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(jq *)"
    ],
    "ask": [
      "Bash(git push --force *)",
      "Bash(git push origin main)",
      "Bash(git pull *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(gh release *)",
      "Bash(gh issue close *)",
      "Bash(pip install *)",
      "Bash(uv add *)",
      "Bash(uv remove *)"
    ]
  }
}
