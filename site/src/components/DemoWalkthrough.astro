---
// The recorded demo run (2026-11-03) as a terminal player with a chapter bar: the bar shows where the playback is and
// each chapter seeks the player to its marker. The full form (the walkthrough page) adds one card per step with what
// you would say, the command it runs, what was typed in the recording, what Claude asked and did, the result and links to the real artifacts; the compact form (the landing
// page) plays while it is in view, unless the reader asks for reduced motion.
// The recording is shipped gzip-compressed (GitHub Pages does not compress it) and unpacked in the browser.
import { glance, parts, steps } from './demo-steps';

interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const src = `${base}/demo/demo-run.cast.gz`;
const marks = steps.map((s) => s.at);
const partAt = (i: number) => parts.find((p) => p.from === i);
---

<div class:list={['walkthrough', { 'is-compact': compact }]} data-walkthrough data-src={src} data-marks={JSON.stringify(marks)} data-compact={compact ? '' : undefined}>
  <ul class="glance">
    {glance.map((g) => <li><strong>{g.value}</strong><span>{g.label}</span></li>)}
  </ul>

  <div class="walkthrough-stage">
    <div class="walkthrough-player" data-player>
      <noscript>The player needs JavaScript; the <a href={`${base}/img/demo.gif`}>animated GIF</a> shows the same run.</noscript>
    </div>
    <div class="chapters">
      <div class="chapters-track" aria-hidden="true"><div class="chapters-fill" data-fill></div></div>
      <ol class="chapters-list" aria-label="Chapters of the recording">
        {steps.map((step, i) => (
          <>
            {partAt(i) && i > 0 && <li class="chapters-break" aria-hidden="true"></li>}
            {partAt(i) && <li class="chapters-part" aria-hidden="true">Part {parts.indexOf(partAt(i)!) + 1}</li>}
            <li><button type="button" data-chapter={i} title={step.title}><span>{i + 1}</span>{step.short}</button></li>
          </>
        ))}
      </ol>
    </div>
  </div>

  {!compact && (
    <ol class="walkthrough-steps">
      {steps.map((step, i) => (
        <>
        {partAt(i) && (
          <li class="walkthrough-part">
            <h3>{partAt(i)!.title}</h3>
            <p>{partAt(i)!.text}</p>
          </li>
        )}
        <li data-step={i}>
          <details name="walkthrough-step">
            <summary><span class="walkthrough-row">
              <span class="walkthrough-num">{i + 1}</span>
              <span class="walkthrough-head">
                <span class="walkthrough-title">{step.title}</span>
                {step.say
                  ? <span class="walkthrough-say"><span class="walkthrough-quote">“{step.say}”</span></span>
                  : <span class="walkthrough-say is-none">Nothing to type: the run goes on by itself</span>}
                <span class="walkthrough-run"><span aria-hidden="true">→</span><code>{step.run}</code></span>
              </span>
              {step.time
                ? <span class="walkthrough-time" title="working time, every wait cut">{step.time}</span>
                : <span class="walkthrough-time" aria-hidden="true"></span>}
            </span></summary>
            <div class="walkthrough-body">
              <section>
                <h4>Typed in the recording</h4>
                <p><code>{step.command}</code></p>
              </section>
              {step.sections.map((sec) => (
                <section>
                  <h4>{sec.heading}</h4>
                  {sec.text && <p set:html={sec.text} />}
                  {sec.items && <ul>{sec.items.map((item) => <li set:html={item} />)}</ul>}
                  {sec.code && <pre><code>{sec.code}</code></pre>}
                </section>
              ))}
              {step.links.length > 0 && (
                <section>
                  <h4>Evidence</h4>
                  <ul class="walkthrough-links">
                    {step.links.map((l) => <li><a href={l.href} target="_blank" rel="noopener">{l.label}</a></li>)}
                  </ul>
                </section>
              )}
            </div>
          </details>
        </li>
        </>
      ))}
    </ol>
  )}
</div>

<script>
  import * as AsciinemaPlayer from 'asciinema-player';
  import 'asciinema-player/dist/bundle/asciinema-player.css';

  const root = document.querySelector<HTMLElement>('[data-walkthrough]');
  if (root) {
    const compact = root.dataset.compact !== undefined;
    const marks: number[] = JSON.parse(root.dataset.marks ?? '[]');
    const chapters = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-chapter]'));
    const items = Array.from(root.querySelectorAll<HTMLLIElement>('li[data-step]'));
    const fill = root.querySelector<HTMLElement>('[data-fill]')!;
    const stage = root.querySelector<HTMLElement>('.walkthrough-stage')!;
    const load = async () => {
      const res = await fetch(root.dataset.src!);
      if (!res.ok) throw new Error(`recording: HTTP ${res.status}`);
      const bytes = new Uint8Array(await res.arrayBuffer());
      if (bytes[0] !== 0x1f || bytes[1] !== 0x8b) return new TextDecoder().decode(bytes);   // a server already unpacked it
      return new Response(new Blob([bytes]).stream().pipeThrough(new DecompressionStream('gzip'))).text();
    };
    const player = AsciinemaPlayer.create({ data: load }, root.querySelector<HTMLElement>('[data-player]')!, {
      fit: 'width', theme: 'monokai', poster: 'npt:0:16', idleTimeLimit: 12, terminalLineHeight: 1.25, loop: compact,
    });

    // the chapter (and step card) the playback is in, and how far it is
    let current = -1;
    const activeAt = (t: number) => marks.reduce((cur, m, i) => (t + 0.05 >= m ? i : cur), 0);
    const highlight = (i: number) => {
      if (i === current) return;
      current = i;
      chapters.forEach((b, j) => b.toggleAttribute('aria-current', i === j));
      const active = chapters[i];
      const list = active?.closest('ol');
      if (active && list && list.scrollWidth > list.clientWidth) {
        list.scrollTo({ left: active.offsetLeft - list.clientWidth / 2 + active.offsetWidth / 2, behavior: 'smooth' });
      }
      items.forEach((li, j) => li.classList.toggle('is-active', i === j));
    };
    player.addEventListener('marker', (e) => highlight(e.index));
    setInterval(async () => {
      const t = (await player.getCurrentTime()) ?? 0;
      const d = (await player.getDuration()) ?? 0;
      highlight(activeAt(t));
      if (d) fill.style.width = `${Math.min(100, (t / d) * 100)}%`;
    }, 500);

    const jump = async (i: number) => {
      highlight(i);
      await player.seek({ marker: i });
      await player.play();
    };
    chapters.forEach((b, i) => b.addEventListener('click', () => jump(i)));

    // opening a step card jumps the player to it and brings the player into view
    items.forEach((li, i) => {
      li.querySelector('details')!.addEventListener('toggle', async (e) => {
        if (!(e.target as HTMLDetailsElement).open) return;
        await jump(i);
        stage.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      });
    });

    // the landing page plays the run while it is on screen, like the GIF did, but never for readers who asked for less motion
    if (compact && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let started = false;
      new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) {
          started = true;
          player.play();
        } else if (started) player.pause();
      }, { threshold: 0.4 }).observe(stage);
    }
  }
</script>

<style>
  .walkthrough { display: grid; gap: 1.25rem; margin-block: 1.5rem; }

  /* the run at a glance */
  .glance { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 8.25rem), 1fr)); gap: 0.5rem; padding: 0; margin: 0; list-style: none; }
  .glance li { margin: 0; padding: 0.7rem 0.85rem; border: 1px solid var(--sl-color-hairline); border-radius: 0.75rem; background: var(--surface, var(--sl-color-bg-nav)); }
  .glance strong { display: block; font-size: var(--sl-text-xl); line-height: 1.2; letter-spacing: -0.02em; background: var(--brand-gradient, var(--sl-color-text-accent)); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
  .glance span { display: block; margin-top: 0.2rem; font-size: var(--sl-text-xs); line-height: 1.45; color: var(--sl-color-gray-2); }

  /* the player and its chapter bar, framed as one window */
  .walkthrough-stage { border: 1px solid var(--sl-color-hairline); border-radius: 0.85rem; overflow: hidden; background: #272822; box-shadow: 0 18px 40px -22px var(--glow, transparent); }
  .walkthrough-player { min-height: 8rem; background: #272822; }
  .chapters { background: #1d1e19; border-top: 1px solid #3a3b33; padding: 0 0.6rem 0.6rem; }
  .chapters-track { height: 3px; margin: 0 -0.6rem 0.55rem; background: #3a3b33; }
  .chapters-fill { height: 100%; width: 0; background: linear-gradient(90deg, #4f46e5, #7c3aed 55%, #0891b2); transition: width 0.5s linear; }
  .chapters-list { display: flex; flex-wrap: wrap; gap: 0.35rem; padding: 0; margin: 0; list-style: none; }
  .chapters-list li { margin: 0; }
  .chapters-list button { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.25rem 0.6rem 0.25rem 0.3rem; border: 1px solid #3a3b33; border-radius: 999px; background: transparent; color: #c9cbbf; font: 500 var(--sl-text-xs) / 1.3 var(--sl-font); cursor: pointer; transition: background-color 0.15s, border-color 0.15s, color 0.15s; }
  .chapters-list button span { display: inline-grid; place-items: center; width: 1.25rem; height: 1.25rem; border-radius: 999px; background: #3a3b33; color: #f8f8f2; font-weight: 700; font-size: 0.7rem; }
  .chapters-list button:hover { border-color: #7c3aed; color: #fff; }
  .chapters-list button[aria-current] { border-color: transparent; background: #7c3aed; color: #fff; }
  .chapters-list button[aria-current] span { background: #fff; color: #4f46e5; }
  .chapters-list button:focus-visible { outline: 2px solid #a78bfa; outline-offset: 2px; }

  /* the step cards */
  .walkthrough-steps { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; }
  .walkthrough-steps > li { margin: 0; border: 1px solid var(--sl-color-hairline); border-radius: 0.75rem; background: var(--surface, var(--sl-color-bg-nav)); transition: border-color 0.2s, box-shadow 0.2s; }
  .walkthrough-steps > li:hover { border-color: color-mix(in srgb, var(--sl-color-accent) 45%, var(--sl-color-hairline)); }
  .walkthrough-steps > li.is-active { border-color: var(--sl-color-accent); box-shadow: 0 0 0 1px var(--sl-color-accent); }
  .walkthrough details { margin: 0; padding: 0; border: 0; background: none; }
  .walkthrough summary { display: block; padding: 0.7rem 0.9rem; cursor: pointer; list-style: none; }
  .walkthrough summary::before, .walkthrough summary::after { content: none !important; display: none !important; }
  .walkthrough summary::-webkit-details-marker, .walkthrough summary::marker { display: none; content: ''; }
  .walkthrough-row { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 0.75rem; }
  .walkthrough-num { display: inline-grid; place-items: center; width: 1.85rem; height: 1.85rem; border-radius: 0.55rem; background: var(--sl-color-accent-low); color: var(--sl-color-accent-high); font-weight: 700; font-size: var(--sl-text-sm); }
  .is-active .walkthrough-num { background: var(--brand-gradient, var(--sl-color-accent)); color: #fff; }
  .walkthrough-head { display: grid; gap: 0.2rem; min-width: 0; }
  .walkthrough-title { font-weight: 600; color: var(--sl-color-white); }
  .walkthrough-say { color: var(--sl-color-gray-2); font-size: var(--sl-text-sm); line-height: 1.45; }
  .walkthrough-quote { font-style: italic; }
  .walkthrough-say.is-none { color: var(--sl-color-gray-3); font-style: normal; }
  .walkthrough-run { display: flex; align-items: baseline; gap: 0.4rem; min-width: 0; color: var(--sl-color-text-accent); font-weight: 700; }
  .walkthrough-run code { font-size: var(--sl-text-xs); font-weight: 500; overflow-wrap: anywhere; }
  .walkthrough-time { display: grid; justify-items: end; font-variant-numeric: tabular-nums; font-size: var(--sl-text-sm); color: var(--sl-color-gray-2); white-space: nowrap; }
  .walkthrough-part { margin: 1rem 0 0.25rem; padding: 0 0.25rem; border: 0 !important; background: none !important; }
  .walkthrough-part:first-child { margin-top: 0; }
  .walkthrough-part h3 { margin: 0; font-size: var(--sl-text-lg); }
  .walkthrough-part p { margin: 0.15rem 0 0; color: var(--sl-color-gray-3); font-size: var(--sl-text-sm); }
  .chapters-part { display: inline-flex; align-items: center; margin: 0 0.15rem 0 0.35rem; color: #8b8fb8; font: 700 0.65rem/1 var(--sl-font); text-transform: uppercase; letter-spacing: 0.08em; }
  .chapters-part { margin-left: 0; min-width: 3.4rem; }
  .chapters-break { flex-basis: 100%; height: 0; margin: 0; }
  .walkthrough-body { padding: 0 0.9rem 0.9rem 3.5rem; display: grid; gap: 0.75rem; }
  .walkthrough-body section { margin: 0; }
  .walkthrough-body h4 { margin: 0 0 0.25rem; font-size: var(--sl-text-xs); text-transform: uppercase; letter-spacing: 0.06em; color: var(--sl-color-gray-3); }
  .walkthrough-body p, .walkthrough-body ul { margin: 0; }
  .walkthrough-body pre { margin: 0.25rem 0 0; padding: 0.6rem 0.75rem; border-radius: 0.5rem; background: var(--sl-color-gray-6); font-size: var(--sl-text-xs); overflow-x: auto; }
  .walkthrough-body :global(.walkthrough-shot) { display: block; width: 100%; max-width: 36rem; height: auto; margin-top: 0.6rem; border: 1px solid var(--sl-color-hairline); border-radius: 0.6rem; }
  .walkthrough-links { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; padding: 0; list-style: none; }
  .walkthrough-links li { margin: 0; }
  @media (max-width: 40rem) {
    /* the chapters become one row to swipe through, so the bar stays shorter than the player */
    .chapters-list { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; padding-bottom: 0.1rem; scroll-snap-type: x proximity; }
    .chapters-list::-webkit-scrollbar { display: none; }
    .chapters-list li { flex: none; scroll-snap-align: start; }
    .chapters-break { display: none; }
    .chapters-part { min-width: 0; margin-left: 0.4rem; }
    .chapters-part:first-child { margin-left: 0; }
    .glance li:last-child:nth-child(odd) { grid-column: 1 / -1; }
    .walkthrough-row { grid-template-columns: auto 1fr; }
    .walkthrough-time { grid-column: 2; justify-items: start; }
    .walkthrough-body { padding-left: 0.9rem; }
  }
</style>
